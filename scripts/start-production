#!/usr/bin/env sh
set -eu
cd "$(dirname "$0")/.."

PORT="${PORT:-8080}"
NODE_PORT="${NODE_PORT:-3000}"
DJANGO_PORT="${DJANGO_PORT:-8000}"

# SvelteKit SSR reaches Django through Caddy, not Gunicorn directly, even
# though both are loopback in this container.
#
# Gunicorn's sync worker calls resp.force_close() on every response, so a
# direct Node -> Gunicorn fetch gets a FIN the instant the body ends. When the
# response is big enough to pause undici's HTTP/1 parser under backpressure
# (over 64 KiB on the wire, post-gzip), Node 24 asserts `!this.paused` from a
# socket 'end' handler: uncatchable, and the SSR process dies. Caddy keeps the
# Node-facing connection alive, so the parser branch that asserts is never
# reached. See https://github.com/The-Flip/flipcommons/issues/726.
#
# This lives here rather than as a Dockerfile ENV because Railway injects PORT
# at runtime. Caddy is guaranteed to be listening whenever SSR calls the API:
# SSR only issues API calls while serving a request, and every request reaches
# it through Caddy.
export INTERNAL_API_BASE_URL="http://127.0.0.1:${PORT}"

# Mirror Railway's commit SHA into the PUBLIC_ namespace at runtime so
# `$env/dynamic/public` in hooks.client.ts resolves to a real release tag
# in the browser. vite.config.ts does the same mirror at build time for
# sourcemap upload, but that only affects the build container's process —
# the Node SSR process launched below is a separate invocation that needs
# its own mirror. Without this, browser events ship with no release tag
# and Sentry can't match them to uploaded sourcemaps.
#
# Only mirror if there's a real value to mirror. Falling through to an
# empty string would stamp Sentry events with release="" instead of
# letting the SDK omit the field — same silent sourcemap-mismatch
# failure mode this mirror exists to prevent. In production the
# core.E207 preflight blocks the deploy if RAILWAY_GIT_COMMIT_SHA is
# unset, so this guard only matters when the script runs outside Railway.
if [ -n "${PUBLIC_RAILWAY_GIT_COMMIT_SHA:-${RAILWAY_GIT_COMMIT_SHA:-}}" ]; then
	export PUBLIC_RAILWAY_GIT_COMMIT_SHA="${PUBLIC_RAILWAY_GIT_COMMIT_SHA:-${RAILWAY_GIT_COMMIT_SHA}}"
fi

cleanup() {
	kill "${CADDY_PID:-0}" "${NODE_PID:-0}" "${DJANGO_PID:-0}" 2>/dev/null || true
}

trap cleanup EXIT INT TERM

.venv/bin/gunicorn config.wsgi:application --config gunicorn.conf.py --bind 127.0.0.1:"${DJANGO_PORT}" --workers 2 --timeout 60 --graceful-timeout 30 &
DJANGO_PID=$!

# SITE_ORIGIN is the one operator-facing setting for the public origin;
# derive the per-runtime names from it here so the values cannot drift.
# ORIGIN tells adapter-node its public URL — without it, Node trusts the
# Host header, which is not a reliable source for it: the value varies by
# caller (Railway's health check sends healthcheck.railway.app, direct hits
# arrive on the Railway origin hostname), and prerendering has no request
# at all. PUBLIC_SITE_ORIGIN carries the same value to the browser, where
# $env/dynamic/public exposes only PUBLIC_-prefixed vars.
#
# The :? guard catches set-but-empty — the Dockerfile bakes
# ENV SITE_ORIGIN="", so `set -u` never fires. It sits on the export
# because an empty PUBLIC_SITE_ORIGIN would degrade silently, while an
# empty ORIGIN crashes Node at boot anyway.
export PUBLIC_SITE_ORIGIN="${SITE_ORIGIN:?SITE_ORIGIN must be the public origin, e.g. https://flipcommons.org}"

cd frontend_runtime
ORIGIN="${SITE_ORIGIN}" HOST=127.0.0.1 PORT="${NODE_PORT}" node build/index.js &
NODE_PID=$!
cd ..

PORT="${PORT}" NODE_PORT="${NODE_PORT}" DJANGO_PORT="${DJANGO_PORT}" \
	caddy run --config /app/Caddyfile --adapter caddyfile &
CADDY_PID=$!

while kill -0 "${CADDY_PID}" 2>/dev/null && \
	kill -0 "${NODE_PID}" 2>/dev/null && \
	kill -0 "${DJANGO_PID}" 2>/dev/null; do
	sleep 1
done

STATUS=1
for pid in "${CADDY_PID}" "${NODE_PID}" "${DJANGO_PID}"; do
	if ! kill -0 "${pid}" 2>/dev/null; then
		wait "${pid}" || STATUS=$?
		break
	fi
done

cleanup
wait || true
exit "${STATUS}"
