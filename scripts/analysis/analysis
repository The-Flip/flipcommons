#!/usr/bin/env sh
# Runner for DuckDB analyses over the Flipcommons database.
#
# Wraps the `duckdb` CLI so the discipline in scripts/analysis/README.md happens
# automatically: every `run` prints the input watermark and the summary, then
# GATES on the checks views — exiting nonzero if any of them returns a row.
#
# Location-independent: it finds its own flipcommons root and cd's there before
# invoking DuckDB, so it can be called from anywhere — including a sister repo
# whose analysis file `.read`s scripts/analysis/catalog.sql. The path you pass is
# resolved against YOUR current directory; everything the analysis file reads
# (scripts/analysis/catalog.sql, backend/db.sqlite3) resolves against flipcommons.
#
# It is a convenience, not the only way in: `duckdb -init <analysis>.sql :memory:`
# from the flipcommons root still works for ad-hoc querying.
#
#   scripts/analysis/analysis describe [<analysis.sql>] [<view>|<macro>|<term>]
#   scripts/analysis/analysis run <analysis.sql> <prefix> [--markdown]
#   scripts/analysis/analysis browse <analysis.sql>
#   scripts/analysis/analysis ui  <analysis.sql>
#   scripts/analysis/analysis snapshot <analysis.sql> <view> [<view>...]
#   scripts/analysis/analysis query <analysis.sql> "<sql>" [--format json|csv|table|lines] [--check <prefix>]
#   scripts/analysis/analysis columns [<analysis.sql>] <view> | --all
#
# <prefix> names the analysis file's own summary/checks pair: `export` ->
# export_summary, export_checks. Both must exist. But the gate is not limited to
# that one view: `run` DISCOVERS every public `*_checks` view in the session and
# fails on a row from any of them, and likewise prints every public `*_context`
# view alongside analysis_context. That is what lets a shared module an analysis
# file `.read`s ship its own invariants and its own watermark without every
# analysis having to remember to fold them in — a dropped `UNION ALL` is exactly
# the kind of silent hole this layer exists to close.
# `query` prints pure data on stdout (diagnostics on stderr) for generators;
# `--check <prefix>` runs that same gate first, so a generator never reads from
# an analysis whose invariants are failing.
# `describe` is the reference: bare, it lists every public view with its COMMENT ON
# VIEW one-liner, then every public macro with its signature and COMMENT ON MACRO;
# named, it adds the live column list for a view, or prints the one-liner for a macro.
# A term matching nothing exactly is a SEARCH: every view and macro whose name or
# one-liner contains it, so "does the catalog know about X" answers with the views
# instead of an error. A term matching nothing at all still exits nonzero.
# Given an analysis file, its OWN views and macros are listed first under the file's
# name and the foundation follows. Only foundation objects are prompted for a missing
# comment — an analysis's are working views and owe nobody a description.
# Both read the session itself, so neither can drift the way a prose table did.
# Both args are optional and order-free — anything ending in .sql is the analysis
# file (default: the foundation), anything else is a view or macro name or a term.
# `columns` is measurement where `describe` is reference: per column, how many rows,
# how many NULL and how many empty string. Named, it prints every column of one view.
# `--all` sweeps every public view and shows only the columns worth a look — any holding
# '' (absence spelled the wrong way; the layer's rule is that absent is NULL) and any
# entirely NULL (a facet the catalog does not hold yet, or a decode that broke). Run it
# after editing a view that reads a physical table. It is a command rather than a check
# because the same measurement as a gate needs an exemption list — 38 of 68 views carry a
# bare `fc.` reference, and `path_prefix` is legitimately '' — and that list is the
# maintenance burden, not the coverage. ~7s for a full sweep, seconds for one view.
# `browse` materializes every public relation (view or table) into
# <analysis>.browse.duckdb, a static, disposable database that desktop clients such
# as TablePlus can open directly.
set -eu

# flipcommons root = two dirs up from this script (…/scripts/analysis/analysis).
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)

need() { command -v duckdb >/dev/null 2>&1 || { echo "duckdb not on PATH" >&2; exit 127; }; }

# The catalog is IMPORTED into DuckDB's own storage, not read out of SQLite in place,
# and `ensure_snapshot` is what keeps that invisible: it re-imports only when
# backend/db.sqlite3 has actually changed, which in practice means after a prod import
# or `make ingest-patches`. The import is under a second for the whole database; the
# staleness test is one stat. Nobody has to ask for a rebuild.
#
# Importing rather than ATTACHing the SQLite file is a CORRECTNESS decision first.
# DuckDB's sqlite scanner collapses two branches of one query that aggregate over
# different attached tables when the pushed-down projection and filter match — and
# `WHERE status IS DISTINCT FROM 'deleted'` makes them match across every simple view
# here. It silently gave `foundation_summary` one vocabulary's count for another's, and
# left `_anchor_scan` reporting one view's liveness for three others. Both defects
# vanish against native storage; see EDITING.md. Speed is the second reason and much
# the smaller one (the self-test roughly halves).
source_db="$root/backend/db.sqlite3"
snapshot="$root/backend/db.analytics.duckdb"

# mtime+size, BSD and GNU stat. Size is in there because mtime alone has one-second
# granularity, and an ingest that rewrites the file inside the same second as the last
# import would otherwise read as unchanged.
source_stamp() {
  stat -f '%m %z' "$source_db" 2>/dev/null || stat -c '%Y %s' "$source_db"
}

ensure_snapshot() {
  need
  [ -f "$source_db" ] || {
    echo "no catalog database at $source_db — run 'make bootstrap' first" >&2; exit 2; }
  want=$(source_stamp)
  if [ -f "$snapshot" ]; then
    # A snapshot written by an older DuckDB fails to open. That is a rebuild, not an
    # error, so the read is allowed to fail and falls through to the import below.
    have=$(duckdb "$snapshot" -noheader -list \
             "SELECT source_mtime || ' ' || source_size FROM _import_stamp" 2>/dev/null) || have=
    [ "$have" = "$want" ] && return 0
  fi
  printf 'importing catalog into DuckDB (source changed)… ' >&2
  # Table by table rather than COPY FROM DATABASE, which refuses on the partial indexes
  # Django creates. Indexes are not copied at all: DuckDB does not use them.
  copy_stmts=$(duckdb :memory: -noheader -list "
    INSTALL sqlite; LOAD sqlite;
    ATTACH '$source_db' AS src (TYPE sqlite, READ_ONLY);
    SELECT 'CREATE TABLE out.\"' || table_name || '\" AS SELECT * FROM src.\"' || table_name || '\";'
    FROM duckdb_tables() WHERE database_name = 'src' ORDER BY table_name;")
  # Build beside the target and rename, so a concurrent reader never sees a half-written
  # snapshot and a failed import leaves the previous one intact.
  tmp="$snapshot.tmp.$$"
  rm -f "$tmp" "$tmp.wal"
  duckdb :memory: "
    INSTALL sqlite; LOAD sqlite;
    ATTACH '$source_db' AS src (TYPE sqlite, READ_ONLY);
    ATTACH '$tmp' AS out;
    $copy_stmts
    CREATE TABLE out._import_stamp AS
      SELECT ${want%% *}::BIGINT AS source_mtime, ${want##* }::BIGINT AS source_size,
             now() AS imported_at;" >/dev/null
  mv "$tmp" "$snapshot"
  rm -f "$tmp.wal"
  echo "done" >&2
}


usage() {
  # The whole header comment, less the shebang: everything down to `set -eu`.
  sed -n "2,$(($(grep -n '^set -eu' "$0" | cut -d: -f1) - 1))p" "$0" |
    sed 's/^# \{0,1\}//' >&2
  exit 2
}

# Resolve an analysis-file path (relative to the CALLER's cwd) to absolute,
# validate it, then cd to the flipcommons root so its relative reads resolve.
resolve_and_cd() {
  case "$1" in
    *.sql) : ;;
    *) echo "expected a .sql analysis file, got: $1" >&2; exit 2 ;;
  esac
  [ -f "$1" ] || { echo "no such file: $1" >&2; exit 2; }
  analysis_file=$(CDPATH= cd -- "$(dirname -- "$1")" && pwd)/$(basename -- "$1")
  cd "$root"
  ensure_snapshot
}

# Public = a view in the session's own catalog (`memory`), not the read-only `fc`
# attachment, and not an _underscore private helper. One definition, shared by
# `describe` and by the discovery below, so the three places that mean "public
# view" cannot come to disagree about it.
pub_where="WHERE database_name = 'memory' AND schema_name = 'main'
           AND NOT starts_with(view_name, '_')"

# Public tables use the same naming convention. Analysis files sometimes materialize
# an expensive intermediate as a TABLE so downstream views do not recompute it; browse
# must carry those relations too or a campaign export is incomplete.
pub_table_where="WHERE database_name = 'memory' AND schema_name = 'main'
                 AND NOT starts_with(table_name, '_')"

# The same idea for MACROS, which are reference surface too — a view comment can tell
# you to call citation_root_for_host(), and describe has to be able to answer what that
# is. `internal` excludes DuckDB's own built-ins, leaving the ones this layer defines.
pub_macro_where="WHERE database_name = 'memory' AND schema_name = 'main'
                 AND NOT internal AND NOT starts_with(function_name, '_')"

# The public views whose name ends in <suffix>, one per line. This is how `run`
# finds the checks to gate on and the contexts to print, rather than taking the
# analysis's word for it: a layer it `.read`s gets picked up without the analysis
# mentioning it, and an analysis cannot quietly opt out of a module's checks.
public_views_ending() {
  duckdb -noheader -list :memory: -c ".read '$analysis_file'" \
    "SELECT view_name FROM duckdb_views() $pub_where
       AND ends_with(view_name, '$1') ORDER BY view_name;"
}

# The gate: require the analysis's own <prefix>_checks, then fail on a row in ANY
# public *_checks view. Shared by `run` and by `query --check`, so a generator
# reading a view out of an analysis gets the SAME verdict a run does. One
# discovery, one definition of clean — a second copy is how the two would drift
# apart, and a generator trusting a weaker gate would emit from a failing one.
#
# $1 = prefix. $2 = where the passing ✓ lines go: `stdout` for `run`, whose job
# is to report, or `stderr` for `query`, whose stdout must stay pure data.
# FAILURES always go to stderr regardless.
# gate <prefix> stdout|stderr|silent — `silent` reports failures and says nothing on
# success, for a command whose output is meant to be consumed rather than read.
gate() {
  gate_prefix=$1; gate_ok=$2
  checks=$(public_views_ending _checks)

  # The analysis's own pair is still required. Without this the failure mode is
  # one that defines <prefix>_summary and drops <prefix>_checks — the exact
  # omission README warns is easiest to make when copying — passing green,
  # because discovery would find only the foundation's or a module's checks
  # and report them clean.
  case "
$checks
" in
    *"
${gate_prefix}_checks
"*) ;;
    *) printf '✗ analysis defines no %s_checks view\n' "$gate_prefix" >&2; exit 2 ;;
  esac

  # Every view is reported, not just the first failure: when a shared module
  # and the analysis both break, seeing one of them is a misleading half-picture.
  bad=0
  for v in $checks; do
    n=$(duckdb -noheader -list :memory: -c ".read '$analysis_file'" "SELECT count(*) FROM $v;")
    if [ "$n" -ne 0 ]; then
      printf '\n✗ %s returned %s row(s):\n' "$v" "$n" >&2
      duckdb :memory: -c ".read '$analysis_file'" "FROM $v;" >&2
      bad=$((bad + 1))
    elif [ "$gate_ok" = stdout ]; then
      printf '\n✓ %s clean\n' "$v"
    elif [ "$gate_ok" = stderr ]; then
      printf '\n✓ %s clean\n' "$v" >&2
    fi
  done
  [ "$bad" -eq 0 ] || exit 1
}

[ $# -ge 1 ] || usage
need
cmd=$1; shift

case "$cmd" in
  run)
    [ $# -ge 2 ] || usage
    sql=$1; prefix=$2; shift 2
    fmt=box
    [ "${1:-}" = "--markdown" ] && fmt=markdown
    resolve_and_cd "$sql"

    # The catalog watermark first, then any companion layer's — a run should
    # certify ALL of its inputs, and a source corpus can be staler than the DB.
    printf '\n— context —\n'
    duckdb -"$fmt" :memory: -c ".read '$analysis_file'" "FROM analysis_context;"
    for v in $(public_views_ending _context); do
      [ "$v" = analysis_context ] && continue
      printf '\n— %s —\n' "$v"
      duckdb -"$fmt" :memory: -c ".read '$analysis_file'" "FROM $v;"
    done

    printf '\n— %s_summary —\n' "$prefix"
    duckdb -"$fmt" :memory: -c ".read '$analysis_file'" "FROM ${prefix}_summary;"

    # Gate: a row in ANY public *_checks view fails the run.
    gate "$prefix" stdout
    ;;

  describe)
    # Both args optional and order-free: *.sql is the file, anything else a view.
    sql=scripts/analysis/catalog.sql; view=
    for a in "$@"; do
      case "$a" in
        *.sql) sql=$a ;;
        *) view=$a ;;
      esac
    done
    resolve_and_cd "$sql"

    pub="FROM duckdb_views() $pub_where"
    # DISTINCT because an overloaded macro has a row per signature.
    pub_macro="SELECT DISTINCT function_name AS n,
                 function_name || '(' || array_to_string(parameters, ', ') || ')' AS sig,
                 comment, function_oid AS oid
               FROM duckdb_functions() $pub_macro_where"

    # Which names the FOUNDATION defines, found by loading it on its own — everything
    # else in the session belongs to the analysis file. The two are held to different
    # standards and conflating them is what made `describe <campaign>.sql` tell a
    # campaign to document its working views: a foundation view is reference surface
    # other analyses build on and `undocumented_view` obliges it to carry a comment,
    # while a campaign's views are scratch for one question and owe nothing.
    # Skipped when the analysis IS the foundation, where the split is meaningless.
    fviews=; fmacros=
    if [ "$analysis_file" != "$root/scripts/analysis/catalog.sql" ]; then
      fviews=$(duckdb -init scripts/analysis/catalog.sql -noheader -list :memory: \
        "SELECT coalesce(string_agg('''' || view_name || '''', ','), '''''') $pub;")
      fmacros=$(duckdb -init scripts/analysis/catalog.sql -noheader -list :memory: \
        "SELECT coalesce(string_agg('''' || n || '''', ','), '''''') FROM ($pub_macro);")
    fi
    # Predicates naming the analysis's OWN objects; empty when describing the foundation.
    # The macro half is a BARE condition, its WHERE supplied at each use: the two callers
    # below build different queries around it, and a second WHERE-carrying spelling is
    # one an edit could update alone.
    own_v=; found_v=; own_m=true; found_m=true
    # Naming one object by name doesn't say which group it is in, so the placeholder
    # becomes conditional: nag for a foundation object, stay silent for the analysis's.
    nag_v="'(undocumented — add a COMMENT ON VIEW)'"
    nag_m="'(undocumented — add a COMMENT ON MACRO)'"
    if [ -n "$fviews" ]; then
      own_v="AND view_name NOT IN ($fviews)";   found_v="AND view_name IN ($fviews)"
      own_m="n NOT IN ($fmacros)";             found_m="n IN ($fmacros)"
      nag_v="CASE WHEN view_name IN ($fviews) THEN $nag_v ELSE '' END"
      nag_m="CASE WHEN n IN ($fmacros) THEN $nag_m ELSE '' END"
    fi

    if [ -z "$view" ]; then
      # The analysis's own objects FIRST — describing a campaign, they are the subject
      # and the foundation is the backdrop. A comment is shown when there is one and
      # simply omitted when there isn't: no obligation, so no placeholder nagging for
      # one. Suppressed entirely when describing the foundation, which has none.
      if [ -n "$own_v" ]; then
        printf '— %s —\n' "$(basename "$analysis_file")"
        duckdb -noheader -list :memory: -c ".read '$analysis_file'" \
          "SELECT view_name || coalesce(chr(10) || '    ' || comment, '')
           $pub $own_v ORDER BY view_oid;"
        duckdb -noheader -list :memory: -c ".read '$analysis_file'" \
          "SELECT sig || coalesce(chr(10) || '    ' || comment, '')
           FROM ($pub_macro) WHERE $own_m ORDER BY oid;"
        printf '\n— foundation —\n'
      fi
      # Index. Rendered as name + indented prose rather than a box table: the
      # comments are sentences, and a box would blow past any terminal width.
      duckdb -noheader -list :memory: -c ".read '$analysis_file'" \
        "SELECT view_name || chr(10) || '    ' ||
                coalesce(comment, '(undocumented — add a COMMENT ON VIEW)')
         $pub $found_v ORDER BY view_oid;"
      # Macros last and labelled, because they are CALLED rather than selected from.
      echo
      echo "— macros —"
      duckdb -noheader -list :memory: -c ".read '$analysis_file'" \
        "SELECT sig || chr(10) || '    ' ||
                coalesce(comment, '(undocumented — add a COMMENT ON MACRO)')
         FROM ($pub_macro) WHERE $found_m ORDER BY oid;"
    else
      # Doubled for SQL. A search term is freer-form than a view name, and an apostrophe
      # in one would otherwise be a syntax error rather than simply matching nothing.
      sql_view=$(printf '%s' "$view" | sed "s/'/''/g")
      n=$(duckdb -noheader -list :memory: -c ".read '$analysis_file'" \
        "SELECT count(*) $pub AND view_name = '$sql_view';")
      if [ "$n" -eq 0 ]; then
        # Not a view — try a macro before giving up, so one name lookup covers both.
        m=$(duckdb -noheader -list :memory: -c ".read '$analysis_file'" \
          "SELECT count(*) FROM ($pub_macro) WHERE n = '$sql_view';")
        if [ "$m" -eq 0 ]; then
          # Naming nothing exactly is a SEARCH, not a mistake. The question behind such
          # a term — does the catalog know about X — is one this layer can answer, and
          # an error answers it wrong: `abbrev` names no view, yet two views are about
          # abbreviations. Names and one-liners only. The block prose above each CREATE
          # never enters the session, which is what the README's greps are for.
          match_v="(contains(lower(view_name), lower('$sql_view'))
                    OR contains(lower(coalesce(comment, '')), lower('$sql_view')))"
          match_m="(contains(lower(n), lower('$sql_view'))
                    OR contains(lower(coalesce(comment, '')), lower('$sql_view')))"

          # $1 = the views' group predicate, $2 = the macros'. Views then macros, each in
          # definition order and rendered exactly as the index above renders them, so a
          # hit reads the same whether you searched for it or scrolled past it. The
          # nullif is what drops the indented line entirely for an analysis's own
          # undocumented object, whose placeholder is the empty string.
          search() {
            duckdb -noheader -list :memory: -c ".read '$analysis_file'" \
              "SELECT txt FROM (
                 SELECT view_name || coalesce(chr(10) || '    ' ||
                          nullif(coalesce(comment, $nag_v), ''), '') AS txt,
                        0 AS kind, view_oid AS ord
                 $pub $1 AND $match_v
                 UNION ALL
                 SELECT sig || coalesce(chr(10) || '    ' ||
                          nullif(coalesce(comment, $nag_m), ''), '') AS txt,
                        1 AS kind, oid AS ord
                 FROM ($pub_macro) WHERE $2 AND $match_m
               ) ORDER BY kind, ord;"
          }

          # A header only where there is something under it: a term hitting one side
          # prints one list rather than an empty section. An empty own_v means there is
          # no split to show at all, which is the case when describing the foundation.
          own_hits=
          [ -n "$own_v" ] && own_hits=$(search "$own_v" "$own_m")
          found_hits=$(search "$found_v" "$found_m")
          [ -n "$own_hits$found_hits" ] ||
            { echo "no such public view or macro: $view" >&2; exit 2; }
          if [ -n "$own_hits" ]; then
            printf '— %s —\n' "$(basename "$analysis_file")"
            printf '%s\n' "$own_hits"
            if [ -n "$found_hits" ]; then printf '\n— foundation —\n'; fi
          fi
          if [ -n "$found_hits" ]; then printf '%s\n' "$found_hits"; fi
          exit 0
        fi
        # Same nullif as the search: an own undocumented macro prints its signature
        # alone, where the view branch below suppresses the row and lets DESCRIBE speak.
        duckdb -noheader -list :memory: -c ".read '$analysis_file'" \
          "SELECT sig || coalesce(chr(10) || '    ' ||
                    nullif(coalesce(comment, $nag_m), ''), '')
           FROM ($pub_macro) WHERE n = '$sql_view';"
        exit 0
      fi
      # The WHERE keeps an undocumented analysis view from printing a blank line.
      duckdb -noheader -list :memory: -c ".read '$analysis_file'" \
        "SELECT coalesce(comment, $nag_v)
         $pub AND view_name = '$sql_view' AND coalesce(comment, $nag_v) <> '';"
      duckdb :memory: -c ".read '$analysis_file'" "DESCRIBE $view;"
    fi
    ;;

  ui)
    [ $# -ge 1 ] || usage
    resolve_and_cd "$1"
    duckdb -ui -init "$analysis_file" :memory:
    ;;

  browse)
    [ $# -eq 1 ] || usage
    resolve_and_cd "$1"
    out="${analysis_file%.sql}.browse.duckdb"
    tmp="${out}.tmp.$$"
    cleanup_browse() { rm -f "$tmp"; }
    trap cleanup_browse EXIT
    trap 'exit 1' HUP INT TERM
    rm -f "$tmp"

    relations=$(duckdb -noheader -list :memory: -c ".read '$analysis_file'" \
      "SELECT relation_name
       FROM (
         SELECT view_name AS relation_name, view_oid AS relation_oid
         FROM duckdb_views() $pub_where
         UNION ALL
         SELECT table_name AS relation_name, table_oid AS relation_oid
         FROM duckdb_tables() $pub_table_where
       )
       ORDER BY relation_oid;")
    [ -n "$relations" ] || {
      echo "analysis defines no public views or tables: $analysis_file" >&2
      exit 2
    }

    sql_tmp=$(printf '%s' "$tmp" | sed "s/'/''/g")
    stmts="ATTACH '$sql_tmp' AS browse;"
    n=0
    while IFS= read -r relation; do
      [ -n "$relation" ] || continue
      sql_relation=$(printf '%s' "$relation" | sed 's/"/""/g')
      stmts="$stmts CREATE TABLE browse.\"$sql_relation\" AS FROM main.\"$sql_relation\";"
      n=$((n + 1))
    done <<EOF
$relations
EOF

    # CREATE TABLE … AS carries rows and types, not the COMMENT, so the comments must be
    # re-attached explicitly. Not folded into the loop above: comments are multi-line, so
    # there is no line-oriented read of them. Views become tables here, so COMMENT ON
    # TABLE is right for both. The count rides along on one query to avoid a fourth run.
    comments=$(duckdb -noheader -list :memory: -c ".read '$analysis_file'" \
      "SELECT count(*) || '|' || coalesce(string_agg(
                'COMMENT ON TABLE browse.\"' || replace(relation_name, '\"', '\"\"')
                || '\" IS ''' || replace(comment, '''', '''''') || ''';',
                ' ' ORDER BY relation_oid), '')
       FROM (
         SELECT view_name AS relation_name, view_oid AS relation_oid, comment
         FROM duckdb_views() $pub_where AND comment IS NOT NULL
         UNION ALL
         SELECT table_name AS relation_name, table_oid AS relation_oid, comment
         FROM duckdb_tables() $pub_table_where AND comment IS NOT NULL
       );")

    documented=${comments%%|*}
    comment_stmts=${comments#*|}

    duckdb :memory: -c ".read '$analysis_file'" "$stmts $comment_stmts"
    mv -f "$tmp" "$out"
    trap - EXIT HUP INT TERM
    noun=relations
    [ "$n" -eq 1 ] && noun=relation
    printf 'wrote %s (%s public %s, %s documented)\n' "$out" "$n" "$noun" "$documented"
    ;;

  query)
    [ $# -ge 2 ] || usage
    sql=$1; query=$2; shift 2
    fmt=table; check=
    while [ $# -gt 0 ]; do
      case "$1" in
        --format)
          case "${2:-}" in
            json|csv|table|lines) fmt=$2; shift 2 ;;
            *) echo "--format must be json, csv, table or lines" >&2; exit 2 ;;
          esac ;;
        --check)
          [ -n "${2:-}" ] || { echo "--check needs a <prefix>" >&2; exit 2; }
          check=$2; shift 2 ;;
        *) echo "unknown query option: $1" >&2; exit 2 ;;
      esac
    done
    resolve_and_cd "$sql"
    # --check runs the same gate `run` does, BEFORE emitting a row. This is the
    # mode a generator wants: reading a view out of an ungated analysis is how a
    # patch gets emitted from an analysis whose invariants are failing, and the
    # emitted YAML looks perfectly well-formed either way. Gate output goes to
    # stderr so stdout stays pure data.
    [ -n "$check" ] && gate "$check" silent
    # Pure data on stdout; DuckDB's own diagnostics already go to stderr.
    # `lines` emits each row verbatim with no header, box or quoting — for a query whose
    # single column IS the rendered output. The other three formats all mangle prose:
    # csv quotes any value holding a comma, json escapes it, table pads it out to the
    # widest row and wraps. Meant for one column; with several, -list joins them on '|'.
    if [ "$fmt" = lines ]; then
      duckdb -noheader -list :memory: -c ".read '$analysis_file'" "$query"
    else
      duckdb -"$fmt" :memory: -c ".read '$analysis_file'" "$query"
    fi
    ;;

  columns)
    # Both args order-free, like describe: *.sql is the file, anything else a view.
    sql=scripts/analysis/catalog.sql; view=; all=
    for a in "$@"; do
      case "$a" in
        --all) all=1 ;;
        *.sql) sql=$a ;;
        *)     view=$a ;;
      esac
    done
    [ -n "$view" ] || [ -n "$all" ] || { echo "columns needs a <view> or --all" >&2; exit 2; }
    resolve_and_cd "$sql"

    # The relation list is derived HERE, in the shell, and that is the whole reason this
    # is a command and not a check. A SQL view cannot iterate relations — query_table()
    # takes literals only — so the same measurement written as a check needs one
    # hand-written UNION branch per relation plus a meta-check to keep that list honest.
    # See EDITING.md.
    # TABLES as well as views, on `browse`'s reasoning: an analysis materializes an
    # expensive intermediate as a table so downstream views don't recompute it, and those
    # are the big relations where a stray '' is least likely to be caught by eye. Sweeping
    # only views would under-report exactly there, and silently.
    views=$(duckdb -noheader -list :memory: -c ".read '$analysis_file'" \
      "SELECT view_name AS rel FROM duckdb_views() $pub_where
         ${view:+AND view_name = '$view'}
       UNION ALL
       SELECT table_name FROM duckdb_tables() $pub_table_where
         ${view:+AND table_name = '$view'}
       ORDER BY rel;")
    [ -n "$views" ] || { echo "no such public view or table: $view" >&2; exit 2; }

    branches=
    for v in $views; do
      branches=${branches:+"$branches UNION ALL "}"SELECT '$v' AS view_name, * FROM _colstats('$v')"
    done

    # Unscoped, the sweep is the interesting reading and the rows are the product: an
    # all-NULL column is a facet the catalog does not hold yet, which is a worklist entry
    # rather than a defect. Filtered when sweeping so the output stays readable; a named
    # view prints every column, because there you asked about that view specifically.
    filter=; [ -n "$all" ] && [ -z "$view" ] && filter="WHERE n_blank > 0 OR n_null = n_rows"
    duckdb -box :memory: -f /dev/stdin <<SQL
.read $analysis_file
-- n_blank cannot see a blank INSIDE a list element: ['a',''] casts to [a, ], never ''.
-- Zero such values today; the gap is latent, and list-typed facets are exactly where a
-- reader would assume coverage.
CREATE OR REPLACE MACRO _colstats(vn) AS TABLE
  WITH n AS (UNPIVOT (SELECT count(*) FILTER (COLUMNS(*) IS NULL) FROM query_table(vn))
               ON COLUMNS(*) INTO NAME col VALUE n_null),
       b AS (UNPIVOT (SELECT count(*) FILTER (COLUMNS(*)::VARCHAR = '') FROM query_table(vn))
               ON COLUMNS(*) INTO NAME col VALUE n_blank)
  SELECT n.col, (SELECT count(*) FROM query_table(vn)) AS n_rows, n.n_null, b.n_blank
  FROM n JOIN b USING (col);
SELECT * FROM ($branches) $filter ORDER BY n_blank DESC, view_name, col;
SQL
    ;;

  snapshot)
    [ $# -ge 2 ] || usage
    sql=$1; shift
    resolve_and_cd "$sql"
    out="${analysis_file%.sql}.duckdb"
    rm -f "$out"
    stmts="ATTACH '$out' AS snap;"
    for v in "$@"; do
      stmts="$stmts CREATE TABLE snap.$v AS FROM $v;"
    done
    duckdb :memory: -c ".read '$analysis_file'" "$stmts"
    printf 'wrote %s (%s)\n' "$out" "$*"
    ;;

  *) usage ;;
esac
