#!/bin/sh
# Mutation-test the foundation self-test: break the catalog on purpose, one way per
# line of catalog_mutations.tsv, and assert the check that should notice actually does.
#
# The self-test proves the foundation holds its invariants. This proves the self-test
# would NOTICE if it stopped — the part that a green run cannot tell you, because a
# no-op check and a passing check both return zero rows.
#
#     scripts/analysis/check-mutations            # all mutations
#     scripts/analysis/check-mutations title      # only those whose name matches
#
# Exits nonzero if any mutation SURVIVES (the defect went unnoticed) or fires the wrong
# check. A check already firing at baseline (doc drift, an expired skip) BLOCKS its own
# mutations without failing the run — see the baseline section below. Run it after
# touching catalog_checks.sql; the everyday gate stays `analysis run`.
#
# Mechanics: the analytics schema is baked into backend/db.analytics.duckdb, and a view
# redefined in an in-memory session cannot intercept what a baked view reads — a baked
# `foundation_checks` resolves `models` inside its own catalog, not through the
# session's shadow. So every probe runs against a writable COPY of the snapshot, inside
# a transaction that is never committed: the mutation redefines the real views, the
# checks are queried, and the copy is pristine again when the process exits.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$root"
runner=scripts/analysis/analysis
baked=backend/db.analytics.duckdb
sqldir=scripts/analysis/sql
spec=scripts/analysis/catalog_mutations.tsv
filter=${1:-}

pass=0; fail=0; skip=0

# A fresh bake first: the probes read the copy, so a stale snapshot would test
# yesterday's schema against today's TSV. The runner owns freshness; one no-op query
# invokes it. Its stored-check warning is noise here — the baseline below makes the
# same point with names — so stderr is dropped for this call only.
"$runner" query "SELECT 1;" >/dev/null 2>&1

work="${TMPDIR:-/tmp}/check-mutations.$$.duckdb"
trap 'rm -f "$work" "$work.wal"' EXIT
trap 'exit 1' HUP INT TERM
cp "$baked" "$work"

# DuckDB writes a coloured `-- Loading resources` banner to stderr; strip the escapes
# and surrounding blanks so an empty result really reads as empty.
clean() { tail -1 | sed 's/\x1b\[[0-9;]*m//g; s/^[[:space:]]*//; s/[[:space:]]*$//'; }

# ── baseline ───────────────────────────────────────────────────────────────────
# Every verdict below is "the expected check appeared". That is only evidence the
# MUTATION caused it if the check was silent to begin with — otherwise a check firing
# on healthy data would pass every mutation that expects it, including mutations whose
# SQL does nothing at all. That reasoning is PER CHECK, though: some checks fire on
# healthy-data drift (a live tag nobody documented, an anchor skip that expired), and
# a drifted doc says nothing about whether union_integrity would notice a broken join.
# So a dirty baseline doesn't abort the run — it BLOCKS exactly the mutations whose
# expected check is already firing, and its noise is subtracted from every probe so
# the remaining verdicts stay trustworthy.
baseline=$(duckdb -readonly "$work" -noheader -list \
  "SELECT COALESCE(string_agg(DISTINCT check_name, ','), '') FROM foundation_checks;" 2>&1 | clean)
if [ -n "$baseline" ]; then
  echo "⚠ baseline is not clean: foundation_checks already returns [$baseline]"
  echo "  Mutations expecting those checks are BLOCKED below; everything else still runs."
fi
# 'a,b' → 'a','b' for SQL NOT IN; empty stays empty.
baseline_sql=$(printf '%s' "$baseline" | sed "s/[^,][^,]*/'&'/g")
in_baseline() { case ",$baseline," in *",$1,"*) return 0 ;; *) return 1 ;; esac; }

# ── coverage ───────────────────────────────────────────────────────────────────
# Every check_name declared in a *_checks.sql file needs a mutation, or nobody has
# proven it fires. This is a COVERAGE list where a missing entry is silent, which is
# why both directions are checked — the spec must not rot into false coverage after a
# check is renamed or dropped.
# The scan runs per *_checks.sql file, opening at that file's FIRST checks view so the
# string literals of anything above it cannot be mistaken for check names. Check
# branches are the top-level UNION arms, indented two spaces; the deeper-indented
# literals inside subqueries are labels, not check names.
declared=$(for f in "$sqldir"/*_checks.sql; do
  awk '/CREATE OR REPLACE VIEW [_a-z]*checks AS/,0' "$f" \
    | grep -oE "^  SELECT (DISTINCT )?'[a-z_]+'" | grep -oE "'[a-z_]+'" | tr -d "'"
done | sort -u)
covered=$(grep -v '^#' "$spec" | cut -f2 | grep -vE '^$|^\*$' | sort -u)

tmp=${TMPDIR:-/tmp}/check-mutations-names.$$
printf '%s\n' "$covered"  > "$tmp"
uncovered=$(printf '%s\n' "$declared" | grep -vxFf "$tmp" || true)
printf '%s\n' "$declared" > "$tmp"
stale=$(printf '%s\n' "$covered" | grep -vxFf "$tmp" || true)
rm -f "$tmp"

if [ -n "$uncovered" ]; then
  echo "✗ checks with no mutation proving they fire:"
  echo "$uncovered" | sed 's/^/    /'
  echo "  Add a line to $spec that breaks what each one guards."
  exit 1
fi
if [ -n "$stale" ]; then
  echo "✗ $spec expects check names that no longer exist:"
  echo "$stale" | sed 's/^/    /'
  exit 1
fi

printf '%-34s %-32s %s\n' NAME EXPECT RESULT

# The mutation SQL redefines the views the checks read, inside the writable copy and
# inside a transaction that is never committed — the process exits after the SELECT and
# the copy rolls back to pristine. The real snapshot is never touched.
#
# Fast path: query foundation_checks FILTERED to the expected check_name. Each check is
# a UNION branch selecting a literal, so DuckDB prunes every other branch and the run
# stays sub-second. A hit is conclusive — that check fired. Only a MISS needs the full
# unfiltered run, to say whether the mutation survived outright or tripped a different
# check. Misses are the rare case, so the suite pays for them rarely.
probe() {  # probe <sql> [check_name] — stderr kept, so a broken mutation is visible
  # Unfiltered (the miss path) drops undocumented_view: nearly every mutation redefines
  # a view with CREATE OR REPLACE, which DROPS that view's COMMENT ON VIEW, so the check
  # fires as an artifact of mutating rather than as the defect under test. Reporting it
  # would turn every genuine SURVIVED into a misleading "WRONG CHECK". The filtered fast
  # path is unaffected, so `view comment dropped` still proves the check itself fires.
  # undocumented_macro is dropped for the same reason: the macro mutations redefine a
  # macro, which drops its COMMENT ON MACRO. Baseline-firing checks are dropped too —
  # they'd report drift the mutation didn't cause, turning SURVIVED into WRONG CHECK
  # and letting a '*' mutation pass on noise.
  _where="WHERE check_name NOT IN ('undocumented_view', 'undocumented_macro'${baseline_sql:+, $baseline_sql})"
  [ -n "${2:-}" ] && _where="WHERE check_name = '$2'"
  _out=$(duckdb "$work" -noheader -list "
      BEGIN TRANSACTION;
      $1
      SELECT COALESCE(string_agg(DISTINCT check_name, ','), '')
      FROM foundation_checks $_where;" 2>&1 || true)
  # A DuckDB error can span several lines and end with a caret, so the verdict cannot
  # come from the last line alone — scan the whole output before reading a value off it.
  case "$_out" in
    *Error*) printf 'ERROR: %s' "$(printf '%s\n' "$_out" | grep -i -m1 error | clean)" ;;
    *)       printf '%s\n' "$_out" | clean ;;
  esac
}

selected=0
while IFS='	' read -r name expect sql; do
  case "$name" in ''|'#'*) continue ;; esac
  case "$name" in *"$filter"*) ;; *) continue ;; esac
  selected=$((selected + 1))

  # A check already firing at baseline would "confirm" any mutation expecting it,
  # including one whose SQL does nothing — so its mutations prove nothing today.
  if [ "$expect" != '*' ] && in_baseline "$expect"; then
    printf '%-34s %-32s BLOCKED — firing at baseline\n' "$name" "$expect"; skip=$((skip + 1)); continue
  fi

  if [ "$expect" != '*' ] && [ "$(probe "$sql" "$expect")" = "$expect" ]; then
    printf '%-34s %-32s ok\n' "$name" "$expect"; pass=$((pass + 1)); continue
  fi

  got=$(probe "$sql")
  case "$got" in
    # A mutation whose own SQL fails would otherwise read as SURVIVED — a real defect
    # report for a test that never ran. Name it for what it is.
    ERROR:*) printf '%-34s %-32s MUTATION FAILED — %s\n' "$name" "$expect" "$got"; fail=$((fail + 1)) ;;
    '')      printf '%-34s %-32s SURVIVED — defect unnoticed\n' "$name" "$expect"; fail=$((fail + 1)) ;;
    *)
      if [ "$expect" = '*' ]; then
        printf '%-34s %-32s ok (%s)\n' "$name" "$expect" "$got"; pass=$((pass + 1))
      else
        printf '%-34s %-32s WRONG CHECK — got %s\n' "$name" "$expect" "$got"; fail=$((fail + 1))
      fi ;;
  esac
done < "$spec"

# A filter that matches nothing must not report success — otherwise a stale or
# misspelled argument yields a green run that executed no tests at all.
if [ "$selected" -eq 0 ]; then
  echo "✗ no mutations matched filter '$filter'"
  exit 1
fi

echo
if [ "$fail" -gt 0 ]; then
  echo "✗ $fail of $((pass + fail)) mutations were not caught"
  exit 1
fi
if [ "$skip" -gt 0 ]; then
  echo "⚠ $pass mutations caught; $skip BLOCKED by baseline drift [$baseline] — those checks are unproven until the foundation is green"
else
  echo "✓ all $pass mutations caught"
fi
