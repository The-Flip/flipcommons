{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node build/index.js",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --write . && eslint . && stylelint \"src/**/*.{css,svelte}\"",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:dom": "vitest run --project dom",
    "test:dom:watch": "vitest --project dom",
    "api:gen": "openapi-typescript ../backend/openapi.json --root-types --root-types-no-schema-prefix --empty-objects-unknown --default-non-nullable -o src/lib/api/schema.d.ts",
    "knip": "knip"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.64.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@testing-library/user-event": "^14.6.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "knip": "^6.16.1",
    "markdownlint-cli2": "^0.22.1",
    "openapi-typescript": "^7.13.0",
    "postcss-custom-media": "^12.0.1",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "stylelint": "^17.13.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^7.3.2",
    "vitest": "^4.1.8",
    "xmllint-wasm": "~5.2.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@sentry/sveltekit": "^10.56.0",
    "diff": "^9.0.0",
    "open-props": "^1.7.23",
    "openapi-fetch": "^0.17.0",
    "postcss-jit-props": "^1.0.16",
    "posthog-js": "^1.383.0",
    "super-sitemap": "~1.0.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "esrap": "<2.2.10 || >2.2.10"
    }
  }
}
