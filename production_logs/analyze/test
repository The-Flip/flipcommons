#!/usr/bin/env sh
# Build the SQL layer against committed fixtures and assert what comes out.
#
#   production_logs/analyze/test                # every case
#   production_logs/analyze/test empty-sentry   # one case, by name
#
# Beside `sql/` rather than inside it, because `build`'s staleness scan covers
# that directory: a fixture edited there would mark the real database out of
# date and trigger a rebuild of production data on a change that has nothing to
# do with it. And under analyze/ rather than at the top of production_logs/,
# which is the incident surface -- `query` and `pull/` are for USING the layer,
# this is for changing it, like `sql/build`.
#
# WHY THIS EXISTS SEPARATELY FROM `checks`. The checks in 90_checks.sql run
# against whatever is in dumps/, which is gitignored, private and always
# changing -- so they can only ever assert things that happen to be true of
# today's production. The failures worth guarding against are the ones the live
# dumps cannot contain: an export that is EMPTY, a line that is MALFORMED, a
# field that VANISHED. Those need data authored on purpose, which is what
# fixtures/dumps/ is.
#
# Each case builds a throwaway copy of the layer -- the real sql/ beside a
# fixture dumps/ -- in a temp directory, so nothing here touches the real
# database and the cases cannot interfere with each other.
set -eu

cd "$(dirname "$0")"
ROOT=$(pwd)
PASS=0
FAIL=0
ONLY=${1:-}

setup() {  # $1 = workdir; lays out analyze/sql + dumps as the build expects them
  mkdir -p "$1/analyze"
  cp -R "$ROOT/sql" "$1/analyze/sql"
  cp -R "$ROOT/fixtures/dumps" "$1/dumps"
}

build() { "$1/analyze/sql/build" --quiet >"$1/build.log" 2>&1; }
q() { duckdb -readonly -noheader -list "$1/analyze/production_logs.duckdb" -c "$2" 2>&1 | tail -1; }

expect() {  # label, want, got
  if [ "$2" = "$3" ]; then
    PASS=$((PASS + 1)); printf '    ok   %s\n' "$1"
  else
    FAIL=$((FAIL + 1)); printf '    FAIL %s: want [%s] got [%s]\n' "$1" "$2" "$3"
  fi
}

skip_case() { [ -n "$ONLY" ] && [ "$ONLY" != "$1" ]; }

# --- the layer builds clean on well-formed input, and every check passes -------
case_baseline() {
  w=$1
  expect "build succeeds" "0" "$(build "$w" && echo 0 || echo 1)"
  expect "no findings"    "0" "$(q "$w" 'SELECT count(*) FROM checks;')"
  expect "app lines"      "3" "$(q "$w" "SELECT count(*) FROM railway_lines WHERE service='app';")"
  expect "postgres lines" "1" "$(q "$w" "SELECT count(*) FROM railway_lines WHERE service='postgres';")"
  expect "cdn requests"   "5" "$(q "$w" 'SELECT count(*) FROM bunny_requests;')"
  # The fixture's one static miss appears three times: at static, at apex and at
  # Railway. The CDN must count it once.
  expect "chained miss counted once at the cdn" "4" \
    "$(q "$w" 'SELECT cdn_requests FROM edge_health;')"
  expect "and once at the origin" "1" \
    "$(q "$w" "SELECT count(*) FROM railway_requests WHERE path='/_app/immutable/chunks/x.js';")"
  # Bunny omits asn entirely rather than sending null or zero, so the reader has to
  # yield NULL for those rows instead of failing the build on the missing key.
  expect "asn parses when present" "60068" \
    "$(q "$w" "SELECT client_asn FROM bunny_requests WHERE request_id='reqE';")"
  expect "and is null when the field is absent" "4" \
    "$(q "$w" "SELECT count(*) FROM bunny_requests WHERE client_asn IS NULL;")"
  # builder output stays out of the container stream: it is its own relation,
  # keyed by the snapshot id, and never inflates the app service's line counts
  expect "build lines"    "3" "$(q "$w" 'SELECT count(*) FROM railway_build_lines;')"
  expect "build keyed by snapshot" "1" \
    "$(q "$w" 'SELECT count(DISTINCT build_id) FROM railway_build_lines;')"
  # one structured app error, one failed build step, one CDN 502 and one Sentry
  # event, each counted at its own tier; the Postgres line is stream_noise and
  # excluded
  expect "problem tiers"  "build|cdn|container|sentry" \
    "$(q "$w" "SELECT string_agg(DISTINCT tier,'|' ORDER BY tier) FROM problems;")"
}

# --- a quiet Sentry window is not a broken build -------------------------------
case_empty_sentry() {
  w=$1
  : > "$w/dumps/sentry/discover_errors.ndjson"
  : > "$w/dumps/sentry/events.ndjson"
  echo '[]' > "$w/dumps/sentry/issues.json"
  echo '[]' > "$w/dumps/sentry/releases.json"
  expect "build survives empty exports" "0" "$(build "$w" && echo 0 || echo 1)"
  expect "no findings"      "0" "$(q "$w" 'SELECT count(*) FROM checks;')"
  expect "sentry errors"    "0" "$(q "$w" 'SELECT count(*) FROM sentry_errors;')"
  expect "sentry uptime"    "0" "$(q "$w" 'SELECT count(*) FROM sentry_uptime;')"
  expect "other sources unaffected" "5" "$(q "$w" 'SELECT count(*) FROM bunny_requests;')"
}

# --- a malformed line fails the build loudly, never parses as data -------------
# Every reader declares its columns, so a corrupt line is a build error rather
# than a silently mis-read row. This pins that failure mode.
case_bunny_bad_json() {
  w=$1
  printf 'not json at all\n' >> "$w/dumps/bunny/flipcommons-html.5969801.2026-08-20.ndjson"
  expect "malformed line fails the build" "1" "$(build "$w" && echo 0 || echo 1)"
}

# --- a level field vanishing must not slip past the vocabulary guard -----------
case_missing_level() {
  w=$1
  f=$w/dumps/railway/deploy.2026-08-20.ndjson
  printf '{"timestamp":"2026-08-20T10:00:09.000000000Z","message":"no level here","tags":{"serviceId":"7e443a50-b7c2-4a0a-8357-400683eebcee","deploymentId":"cccccccc-1111-2222-3333-444444444444"},"attributes":[{"key":"logger","value":"\\"x\\""},{"key":"pid","value":"7"}]}\n' >> "$f"
  expect "build succeeds" "0" "$(build "$w" && echo 0 || echo 1)"
  expect "unnormalised_level fires on NULL" "1" \
    "$(q "$w" "SELECT count(*) FROM checks WHERE check_name='unnormalised_level';")"
  expect "and names it" "1" \
    "$(q "$w" "SELECT count(*) FROM checks WHERE detail LIKE 'Level NULL%';")"
}

# --- an SSR line is a named emitter, not unstructured noise --------------------
# Production has not deployed $lib/log yet, so no live dump can contain one of
# its lines. Without this the `emitter` CASE could silently pool them with
# container lifecycle text and the level they carry would look accidental.
case_ssr_json() {
  w=$1
  f=$w/dumps/railway/deploy.2026-08-20.ndjson
  printf '{"timestamp":"2026-08-20T10:00:08.000000000Z","message":"[404] GET /nope","severity":"warn","tags":{"serviceId":"7e443a50-b7c2-4a0a-8357-400683eebcee","deploymentId":"cccccccc-1111-2222-3333-444444444444"},"attributes":[{"key":"level","value":"\\"warn\\""},{"key":"logger","value":"\\"handle-error\\""},{"key":"time","value":"\\"2026-08-20T10:00:08.000Z\\""},{"key":"status","value":"404"}]}\n' >> "$f"
  expect "build succeeds" "0" "$(build "$w" && echo 0 || echo 1)"
  expect "no findings" "0" "$(q "$w" 'SELECT count(*) FROM checks;')"
  expect "resolves to the node emitter" "node" \
    "$(q "$w" "SELECT emitter FROM railway_lines WHERE logger='handle-error';")"
  # The whole point: warn survives as warn instead of being read off stderr.
  expect "keeps its own warn level" "warn|json" \
    "$(q "$w" "SELECT level || '|' || level_confidence FROM railway_lines WHERE logger='handle-error';")"
  # `status` is a caller attribute, not one of the formatter's own fields.
  expect "publishes status as an attribute" "[status]" \
    "$(q "$w" "SELECT extra_keys FROM railway_lines WHERE logger='handle-error';")"
}

# --- a mistyped chain origin brings the double count back, and is named --------
# The topology lives in a hand-typed table, so this is the mistake a live dump can
# never contain: static's origin no longer matches the apex hostname, so it resolves
# as Railway-facing and its misses count twice. The check must say so.
case_zone_origin_typo() {
  w=$1
  f=$w/analyze/sql/00_reference.sql
  sed "s/^   'flipcommons.org',\$/   'flipcommons.og',/" "$f" > "$f.tmp" && mv "$f.tmp" "$f"
  expect "build succeeds" "0" "$(build "$w" && echo 0 || echo 1)"
  expect "static resolves as railway-facing" "apex|static" \
    "$(q "$w" "SELECT string_agg(zone, '|' ORDER BY zone) FROM railway_facing_zones;")"
  expect "railway_facing_zones_not_one fires" "1" \
    "$(q "$w" "SELECT count(*) FROM checks WHERE check_name='railway_facing_zones_not_one';")"
  expect "and the double count is back" "5" \
    "$(q "$w" 'SELECT cdn_requests FROM edge_health;')"
}

for c in baseline empty_sentry bunny_bad_json missing_level ssr_json zone_origin_typo; do
  name=$(echo "$c" | tr '_' '-')
  skip_case "$name" && continue
  printf '  %s\n' "$name"
  w=$(mktemp -d)
  setup "$w"
  "case_$c" "$w"
  rm -rf "$w"
done

printf '\n%s passed, %s failed\n' "$PASS" "$FAIL"
[ "$FAIL" = 0 ]
