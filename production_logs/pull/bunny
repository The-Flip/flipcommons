#!/usr/bin/env python3
"""Download Bunny CDN edge logs into production_logs/dumps/bunny/.

Bunny is the outermost hop, so it is the only source that sees a request that
never reached Railway -- a 502 at the edge, a cache HIT, a bot never let
through. It is also the most perishable: the Logging API keeps a rolling
**three days** and then the day is gone for good.

    production_logs/pull/bunny --start 2026-08-26                # through today
    production_logs/pull/bunny --start 2026-08-26 --end 2026-08-26
    production_logs/pull/bunny --start 2026-08-26 --zone 5969801 # repeatable

Rows come from the Logging API v2 (structured JSON, arbitrary windows,
paginated) and are written verbatim, one ndjson file per zone per UTC day,
merged on requestId -- so re-pulling today only ever adds rows, and a day
outside retention is answered with a clean 400 which is reported and skipped,
not an error. Needs BUNNY_API_KEY -- the *account* API key from the Bunny
dashboard, not a storage-zone password.

The remote IP is anonymized to a /24 unless the account has signed Bunny's DPA
and turned anonymization off, so it identifies a network and not a client; the
manifest records which.
"""

from __future__ import annotations

import argparse
import json
import re
import sys
import urllib.parse
from datetime import UTC, date, datetime, timedelta
from pathlib import Path
from typing import Any, NamedTuple

sys.path.insert(0, str(Path(__file__).resolve().parent))
from pull_common import (  # noqa: E402
    Row,
    add_window_args,
    http_request,
    log,
    manifest_record,
    merge_ndjson,
    preflight,
    update_manifest,
    window,
)

DEFAULT_OUT = Path(__file__).resolve().parent.parent / "dumps" / "bunny"
API_BASE = "https://api.bunny.net"
LOGGING_BASE = "https://logging.bunnycdn.com"
PAGE_LIMIT = 10000  # the v2 maximum per page

# LogAnonymizationType is an integer enum on the wire. Spelled out because a
# bare 0 in the manifest reads as "no anonymization", which is its opposite.
ANONYMIZATION = {0: "OneDigit", 1: "Drop"}


class Zone(NamedTuple):
    """One pull zone, with the settings that change how its logs read."""

    id: int
    name: str
    logging_enabled: bool
    anonymization: str | None  # None when the account logs whole client IPs


def list_zones(key: str) -> list[Zone]:
    """Every pull zone on the account.

    Zone ids are read rather than hardcoded because rebinding the apex to a new
    zone changes the id, and a hardcoded list would then keep pulling a zone
    that no longer serves anything while reporting success.
    """
    body, _ = http_request(f"{API_BASE}/pullzone?page=0&perPage=1000", {"AccessKey": key})
    payload: Any = json.loads(body)
    rows = payload["Items"] if isinstance(payload, dict) else payload
    return [
        Zone(
            id=row["Id"],
            name=row.get("Name") or str(row["Id"]),
            logging_enabled=bool(row.get("EnableLogging")),
            anonymization=_anonymization(row),
        )
        for row in rows
    ]


def _anonymization(row: dict[str, Any]) -> str | None:
    """How this zone masks the client IP, or None if it does not mask it."""
    if not row.get("LoggingIPAnonymizationEnabled"):
        return None
    kind = row.get("LogAnonymizationType", 0)
    return ANONYMIZATION.get(kind, f"type-{kind}")


def slug(name: str) -> str:
    """A zone name reduced to something safe to put in a filename."""
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-") or "zone"


def fetch_day(zone: Zone, day: date, key: str) -> list[Row] | None:
    """One zone-day from the v2 API, whole, or None for a day outside retention.

    Pages on offset until the API says hasMore is false. The out-of-retention
    answer is a clean 400 naming the retention window -- vendor-has-nothing,
    not a failure.
    """
    start = datetime.combine(day, datetime.min.time(), UTC)
    params = {
        "from": start.strftime("%Y-%m-%dT%H:%M:%SZ"),
        "to": (start + timedelta(days=1)).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "limit": str(PAGE_LIMIT),
    }
    rows: list[Row] = []
    offset = 0
    while True:
        query = urllib.parse.urlencode({**params, "offset": str(offset)})
        body, status = http_request(
            f"{LOGGING_BASE}/v2/pullzones/{zone.id}/logs?{query}",
            {"AccessKey": key},
            ok_statuses=frozenset({400, 401}),
        )
        if status == 401:
            log(
                "HTTP 401 from the logging API -- BUNNY_API_KEY must be the "
                "account API key, not a storage-zone password."
            )
            raise SystemExit(1)
        if status == 400:
            detail = _error_detail(body)
            if "retention" in detail.lower():
                return None
            log(f"HTTP 400 on {zone.name} {day}: {detail}")
            raise SystemExit(1)
        payload = json.loads(body)
        rows.extend(payload["data"])
        if not payload["pagination"]["hasMore"]:
            return rows
        offset += payload["pagination"]["returned"]


def _error_detail(body: bytes) -> str:
    """The human half of a v2 error body, or the raw excerpt if it isn't one."""
    try:
        error = json.loads(body)["error"]
        return "; ".join([error.get("message", ""), *error.get("details", [])])
    except (ValueError, KeyError):
        return body[:300].decode(errors="replace")


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    add_window_args(parser)
    parser.add_argument(
        "--zone", type=int, action="append", default=[],
        help="pull zone id; repeatable. Default is every zone on the account.",
    )
    parser.add_argument("--out", type=Path, default=DEFAULT_OUT)
    args = parser.parse_args()
    win = window(args)
    key = preflight("BUNNY_API_KEY")["BUNNY_API_KEY"]

    zones = list_zones(key)
    if args.zone:
        known = {zone.id for zone in zones}
        if missing := set(args.zone) - known:
            unknown = ", ".join(str(z) for z in sorted(missing))
            raise SystemExit(f"no such pull zone on this account: {unknown}")
        zones = [zone for zone in zones if zone.id in set(args.zone)]

    args.out.mkdir(parents=True, exist_ok=True)
    today = datetime.now(UTC).date()
    records: list[Row] = []
    for zone in zones:
        note = "" if zone.logging_enabled else "  (logging DISABLED on this zone)"
        log(f"== {zone.name} [{zone.id}]{note}")
        for day in win.days:
            rows = fetch_day(zone, day, key)
            if rows is None:
                log(f"   {day}  outside Bunny's rolling 3-day retention; skipped")
                continue
            if not rows:
                log(f"   {day}  no rows")
                continue
            dest = args.out / f"{slug(zone.name)}.{zone.id}.{day}.ndjson"
            merged = merge_ndjson(
                dest, rows, key=lambda r: r["requestId"], ts_of=lambda r: str(r["timestamp"])
            )
            marker = "" if day < today else " (today: still accumulating)"
            log(f"   {day}  {merged.rows:>7} rows ({merged.carried} carried over){marker}")
            records.append(
                manifest_record(
                    dest.name,
                    kind="edge",
                    rows=merged.rows,
                    first_ts=merged.first_ts,
                    last_ts=merged.last_ts,
                    complete=day < today,
                    zone_id=zone.id,
                    zone_name=zone.name,
                    logging_enabled=zone.logging_enabled,
                    ip_anonymization=zone.anonymization,
                )
            )
    update_manifest(args.out, records)


if __name__ == "__main__":
    main()
