#!/usr/bin/env python3
"""Download Railway logs into production_logs/dumps/railway/.

    production_logs/pull/railway --start 2026-08-26                # through today
    production_logs/pull/railway --start 2026-08-26 --end 2026-08-26

Talks straight to Railway's GraphQL API with the project token -- the `railway`
CLI is not involved. Two log streams, written verbatim, one ndjson file per UTC
day, so a re-pull only ever adds rows:

  * deploy.<day>.ndjson -- environmentLogs: every service's container output,
    environment-wide, no per-deployment addressing. Rows carry severity, tags
    (serviceId, deploymentId, ...) and a key/value attributes list. Merged on
    (timestamp, message). The API caps each response around 100 rows, so the
    fetch pages backwards from the window's end.
  * http.<day>.ndjson -- httpLogs: the edge's request log. Addressed per
    deployment, so deployments are enumerated first: every one created inside
    the window, plus each service's one already serving when the window opened
    (walking back past deployments that never served). Merged on requestId.
    Pages the same way; a page shorter than asked means the window is exhausted.
  * build.<day>.ndjson -- buildLogs: the builder's output, addressed per
    deployment like httpLogs but fetched for EVERY status -- a FAILED build's
    logs are the ones worth having. Rows carry the build in tags.snapshotId;
    tags.deploymentId is null, since the build precedes the deployment
    instance. Merged on (timestamp, message), like the deploy stream.

Needs RAILWAY_TOKEN -- a *project* token (Settings > Tokens on the project).
Retention is plan-based (7 days on Hobby, 30 on Pro), so a day past the plan's
horizon simply returns nothing.
"""

from __future__ import annotations

import argparse
import json
import sys
from datetime import UTC, datetime, timedelta
from pathlib import Path
from typing import Any, NamedTuple

sys.path.insert(0, str(Path(__file__).resolve().parent))
from pull_common import (  # noqa: E402
    Row,
    Window,
    add_window_args,
    bucket_by_day,
    die,
    http_request,
    iso_z,
    log,
    manifest_record,
    merge_ndjson,
    preflight,
    update_manifest,
    window,
)

DEFAULT_OUT = Path(__file__).resolve().parent.parent / "dumps" / "railway"
GRAPHQL = "https://backboard.railway.com/graphql/v2"
DEPLOY_PAGE = 1000  # the API answers ~100 regardless; asking high costs nothing
HTTP_PAGE = 5000  # honoured; a shorter answer means the window is exhausted
BUILD_PAGE = 5000  # honoured; a whole build is typically ~1-2k lines
ENUM_LIMIT = 100  # deployments enumerated; warned about if it can't span the window

ENV_LOGS_QUERY = """query($eid: String!, $anchor: String!, $floor: String!, $limit: Int!) {
  environmentLogs(environmentId: $eid, anchorDate: $anchor, beforeDate: $floor, beforeLimit: $limit) {
    timestamp message severity
    tags { projectId environmentId serviceId deploymentId deploymentInstanceId snapshotId }
    attributes { key value }
  }
}"""

HTTP_LOGS_QUERY = """query($dep: String!, $anchor: String!, $floor: String!, $limit: Int!) {
  httpLogs(deploymentId: $dep, anchorDate: $anchor, beforeDate: $floor, beforeLimit: $limit) {
    timestamp method path httpStatus totalDuration requestId host clientUa srcIp
    edgeRegion txBytes rxBytes upstreamRqDuration upstreamAddress upstreamProto
    downstreamProto upstreamErrors responseDetails deploymentId deploymentInstanceId
  }
}"""

BUILD_LOGS_QUERY = """query($dep: String!, $start: DateTime!, $end: DateTime!, $limit: Int!) {
  buildLogs(deploymentId: $dep, startDate: $start, endDate: $end, limit: $limit) {
    timestamp message severity
    tags { projectId environmentId serviceId deploymentId deploymentInstanceId snapshotId }
    attributes { key value }
  }
}"""

DEPLOYMENTS_QUERY = """query($pid: String!, $eid: String!, $limit: Int!) {
  deployments(first: $limit, input: {projectId: $pid, environmentId: $eid}) {
    edges { node { id createdAt status service { name } } }
  }
}"""


class Deployment(NamedTuple):
    """One deployment, as enumerated for the httpLogs fetch."""

    id: str
    created_at: str
    status: str
    service: str


def gql(token: str, query: str, variables: dict[str, Any]) -> dict[str, Any]:
    """One GraphQL request. Errors inside a 200 body are still failures."""
    body, _ = http_request(
        GRAPHQL,
        headers={"Project-Access-Token": token, "Content-Type": "application/json"},
        body=json.dumps({"query": query, "variables": variables}).encode(),
    )
    payload = json.loads(body)
    if payload.get("errors"):
        die(1, f"GraphQL error: {json.dumps(payload['errors'])[:500]}")
    data: dict[str, Any] = payload["data"]
    return data


def resolve_ids(token: str) -> tuple[str, str]:
    """The project and environment this token is scoped to."""
    data = gql(token, "{ projectToken { projectId environmentId } }", {})
    scope = data["projectToken"]
    return scope["projectId"], scope["environmentId"]


def page_backwards(
    fetch_page: Any, win: Window, ts_of: Any, row_key: Any
) -> list[Row]:
    """Drain a window by paging backwards from its end.

    Each page is anchored at the oldest timestamp seen so far, which refetches
    that instant; duplicates are dropped here on the same key the dump merges
    on. Stops when a page brings nothing new or the floor is reached.
    """
    floor = win.start.strftime("%Y-%m-%dT%H:%M:%SZ")
    anchor = win.end.strftime("%Y-%m-%dT%H:%M:%S.%fZ")
    rows: list[Row] = []
    seen: set[object] = set()
    while True:
        page = fetch_page(anchor, floor)
        fresh = [row for row in page if row_key(row) not in seen]
        if not fresh:
            return rows
        seen.update(row_key(row) for row in fresh)
        rows.extend(fresh)
        oldest = min(ts_of(row) for row in page)
        if oldest <= floor:
            return rows
        anchor = oldest


def build_logs_for(token: str, deployment_id: str, start: str, end: str) -> list[Row]:
    """Drain one deployment's build logs by paging backwards from the window's end.

    buildLogs takes a date range and a limit rather than the anchor/floor shape
    the other streams use, but behaves the same way: a limit smaller than the
    range answers the NEWEST rows (oldest-first within the page). So a full page
    may have older siblings, and the next page ends at the oldest timestamp
    seen, which refetches that instant; duplicates drop on the merge key here.
    """
    rows: list[Row] = []
    seen: set[object] = set()
    while True:
        page = gql(
            token, BUILD_LOGS_QUERY,
            {"dep": deployment_id, "start": start, "end": end, "limit": BUILD_PAGE},
        )["buildLogs"]
        fresh = [r for r in page if (r["timestamp"], r["message"]) not in seen]
        rows.extend(fresh)
        seen.update((r["timestamp"], r["message"]) for r in fresh)
        if len(page) < BUILD_PAGE or not fresh:
            return rows
        end = min(str(r["timestamp"]) for r in page)


def pick_deployments(deployments: list[Deployment], win: Window) -> list[Deployment]:
    """The deployments whose httpLogs can hold rows inside the window.

    Per service: every deployment created inside the window, plus the one
    already serving when it opened -- found by walking back past deployments
    that never served (SKIPPED, FAILED). The listing is newest-first.
    """
    floor = win.start.strftime("%Y-%m-%dT%H:%M:%S.%fZ")
    ceiling = win.end.strftime("%Y-%m-%dT%H:%M:%S.%fZ")
    picked: list[Deployment] = []
    spanned: set[str] = set()
    for dep in deployments:
        if dep.created_at >= ceiling:
            continue
        if dep.created_at >= floor:
            picked.append(dep)
        elif dep.service not in spanned:
            if dep.status in ("SUCCESS", "REMOVED"):
                spanned.add(dep.service)
                picked.append(dep)
    return picked


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    add_window_args(parser)
    parser.add_argument("--out", type=Path, default=DEFAULT_OUT)
    args = parser.parse_args()
    win = window(args)
    token = preflight("RAILWAY_TOKEN")["RAILWAY_TOKEN"]

    project_id, environment_id = resolve_ids(token)
    args.out.mkdir(parents=True, exist_ok=True)
    today = datetime.now(UTC).date()
    records: list[Row] = []

    def write_days(rows: list[Row], kind: str, merge_key: Any) -> None:
        for day, day_rows in sorted(bucket_by_day(rows, lambda r: str(r["timestamp"])).items()):
            dest = args.out / f"{kind}.{day}.ndjson"
            merged = merge_ndjson(dest, day_rows, key=merge_key, ts_of=lambda r: str(r["timestamp"]))
            marker = "" if day < today else " (today: still accumulating)"
            log(f"   {day}  {merged.rows:>7} rows ({merged.carried} carried over){marker}")
            records.append(
                manifest_record(
                    dest.name, kind=kind, rows=merged.rows, first_ts=merged.first_ts,
                    last_ts=merged.last_ts, complete=day < today,
                )
            )

    log("== deploy logs (environment-wide)")
    deploy_rows = page_backwards(
        lambda anchor, floor: gql(
            token, ENV_LOGS_QUERY,
            {"eid": environment_id, "anchor": anchor, "floor": floor, "limit": DEPLOY_PAGE},
        )["environmentLogs"],
        win,
        ts_of=lambda r: str(r["timestamp"]),
        row_key=lambda r: (r["timestamp"], r["message"]),
    )
    write_days(deploy_rows, "deploy", lambda r: (r["timestamp"], r["message"]))

    log("== http logs (per deployment)")
    edges = gql(
        token, DEPLOYMENTS_QUERY,
        {"pid": project_id, "eid": environment_id, "limit": ENUM_LIMIT},
    )["deployments"]["edges"]
    deployments = [
        Deployment(
            id=e["node"]["id"], created_at=e["node"]["createdAt"],
            status=e["node"]["status"], service=e["node"]["service"]["name"],
        )
        for e in edges
    ]
    if len(deployments) >= ENUM_LIMIT and deployments[-1].created_at > win.start.isoformat():
        log(
            f"warning: {ENUM_LIMIT} deployments do not reach back to {win.days[0]}; "
            "the oldest part of the window may be missing http rows"
        )
    picked = pick_deployments(deployments, win)
    http_rows: list[Row] = []
    for dep in picked:
        rows = page_backwards(
            lambda anchor, floor: gql(
                token, HTTP_LOGS_QUERY,
                {"dep": dep.id, "anchor": anchor, "floor": floor, "limit": HTTP_PAGE},
            )["httpLogs"],
            win,
            ts_of=lambda r: str(r["timestamp"]),
            row_key=lambda r: r["requestId"],
        )
        log(f"   {dep.service} {dep.id[:8]} {dep.status:<8} {len(rows)} rows")
        http_rows.extend(rows)
    write_days(http_rows, "http", lambda r: r["requestId"])

    log("== build logs (per deployment)")
    # Every status, unlike the http pick: SKIPPED and FAILED deployments never
    # served a request but did (try to) build, and a FAILED build's logs are the
    # ones worth having. The two-hour lookback catches a build that started just
    # before the window opened and ran into it.
    lookback = iso_z(win.start - timedelta(hours=2))
    ceiling = win.end.strftime("%Y-%m-%dT%H:%M:%S.%fZ")
    build_rows: list[Row] = []
    for dep in deployments:
        if not lookback <= dep.created_at < ceiling:
            continue
        rows = build_logs_for(token, dep.id, dep.created_at, ceiling)
        log(f"   {dep.service} {dep.id[:8]} {dep.status:<8} {len(rows)} rows")
        build_rows.extend(rows)
    write_days(build_rows, "build", lambda r: (r["timestamp"], r["message"]))

    update_manifest(args.out, records)


if __name__ == "__main__":
    main()
