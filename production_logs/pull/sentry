#!/usr/bin/env python3
"""Download Sentry issues, events and releases into production_logs/dumps/sentry/.

    production_logs/pull/sentry --start 2026-08-01              # through today
    production_logs/pull/sentry --start 2026-08-01 --end 2026-08-14
    production_logs/pull/sentry --start 2026-06-01 --org some-org

Sentry keeps events for 90 days; the dump on disk can therefore outlive what
the API can return, and no pull, however narrow, discards what a wider one
reached. The files differ in how a re-run combines with the copy on disk:

  * Event streams (events.ndjson, discover_errors.ndjson, events/*.ndjson)
    MERGE on the event id; a re-fetched event supersedes the stored one.
  * issues.json is a windowed snapshot of MUTABLE state -- an issue's status,
    its all-time count, its lastSeen -- so it has no timestamp axis to append
    along. It merges on the issue id, and every row carries `_observed_at`, the
    instant the pull that wrote it read Sentry. Without the stamp a carried
    row would silently claim to be current; read it before trusting a count.
  * projects.json and releases.json are fetched org-wide rather than windowed,
    so a window cannot narrow them and they are simply REPLACED.

The pull fails (exit 1) if its haul disagrees with Sentry's own count()
aggregate -- a silently short pull looks exactly like a quiet week. Nothing
here interprets the data; shaping and grain rules belong to
production_logs/analyze/sql/. Needs SENTRY_API_TOKEN.
"""

from __future__ import annotations

import argparse
import json
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import UTC, datetime
from pathlib import Path
from typing import Any, Iterator, NamedTuple

sys.path.insert(0, str(Path(__file__).resolve().parent))
from pull_common import (  # noqa: E402
    USER_AGENT,
    Row,
    add_window_args,
    log,
    manifest_record,
    merge_ndjson,
    preflight,
    update_manifest,
    window,
)

DEFAULT_OUT = Path(__file__).resolve().parent.parent / "dumps" / "sentry"
TIME_FMT = "%Y-%m-%dT%H:%M:%S"

# Discover fields worth having as a flat table. Anything nested stays in the
# full event payloads rather than being flattened into a column here.
DISCOVER_FIELDS = (
    "id", "timestamp", "message", "title", "level", "project.name", "release",
    "environment", "transaction", "culprit", "url", "user.id", "user.email",
    "user.ip", "browser.name", "os.name", "sdk.name", "sdk.version", "issue",
    "server_name",
)


class Page(NamedTuple):
    """One API response: its rows, and the cursor URL for the next page if any."""

    rows: list[Row]
    next_url: str | None


class Sentry:
    """A thin paginating client. Retries the failures that are worth retrying.

    Keeps its own request loop rather than using pull_common.http_request
    because pagination lives in the Link response header, which that helper
    does not surface.
    """

    def __init__(self, token: str) -> None:
        self._token = token
        # Overwritten with the org's own region host once an org is resolved;
        # sentry.io redirects region-owned resources rather than serving them.
        self.base = "https://sentry.io/api/0"

    def _get(self, url: str) -> Page:
        for attempt in range(6):
            request = urllib.request.Request(
                url,
                headers={"Authorization": f"Bearer {self._token}", "User-Agent": USER_AGENT},
            )
            try:
                with urllib.request.urlopen(request, timeout=90) as response:
                    body = json.loads(response.read())
                    rows = body["data"] if isinstance(body, dict) and "data" in body else body
                    return Page(rows, _next_cursor(response.headers.get("Link", "")))
            except urllib.error.HTTPError as error:
                if error.code not in (429, 502, 503, 504):
                    detail = error.read()[:300].decode(errors="replace")
                    raise SystemExit(f"HTTP {error.code} on {url}\n{detail}") from error
                # 429 carries the wait; the 5xxs get exponential backoff.
                delay = int(error.headers.get("Retry-After") or 2**attempt)
                log(f"  {error.code}; retrying in {delay}s")
                time.sleep(delay)
            except (urllib.error.URLError, TimeoutError) as error:
                log(f"  {error}; retrying")
                time.sleep(2**attempt)
        raise SystemExit(f"gave up after repeated failures on {url}")

    def get(self, path: str, **params: str) -> list[Row]:
        """Every row from every page of one endpoint."""
        # Some paths arrive carrying their own query string (the Discover
        # endpoints need repeated `field=` keys, which urlencode cannot express).
        separator = "&" if "?" in path else "?"
        url = f"{self.base}{path}{separator}{urllib.parse.urlencode(params)}" if params else f"{self.base}{path}"
        rows: list[Row] = []
        while url:
            page = self._get(url)
            if not page.rows:
                break
            rows.extend(page.rows)
            url = page.next_url or ""
            time.sleep(0.25)  # deliberately unhurried; these are bulk pulls
        return rows


def _next_cursor(link_header: str) -> str | None:
    """The next-page URL, but only when Sentry says a next page has results.

    Sentry always emits a `next` link. It sets results="false" on the last page,
    so following the link blindly loops forever on an empty response.
    """
    for part in link_header.split(","):
        match = re.search(r'<([^>]+)>;\s*rel="next".*?results="(\w+)"', part)
        if match and match.group(2) == "true":
            return match.group(1)
    return None


def event_key(row: Row) -> str:
    """Identity of an event. Sentry's event id is unique across both streams."""
    return str(row.get("id") or json.dumps(row, sort_keys=True))


def event_time(row: Row) -> str:
    """Sort key. Discover rows carry `timestamp`, full payloads carry `dateCreated`."""
    return str(row.get("timestamp") or row.get("dateCreated") or "")


def write_events(path: Path, rows: list[Row], kind: str, complete: bool) -> Row:
    """Merge an event stream into its dump and describe it for the manifest."""
    merged = merge_ndjson(path, rows, key=event_key, ts_of=event_time)
    log(f"  {path.name}: {merged.rows} rows ({merged.carried} carried over)")
    name = path.name if path.parent.name != "events" else f"events/{path.name}"
    return manifest_record(
        name, kind=kind, rows=merged.rows, first_ts=merged.first_ts or None,
        last_ts=merged.last_ts or None, complete=complete,
    )


def write_snapshot(path: Path, payload: list[Row], kind: str) -> Row:
    """Replace an org-wide snapshot file whole. See the module docstring."""
    _write_atomic(path, json.dumps(payload, indent=1, sort_keys=True))
    log(f"  {path.name}: {len(payload)} rows")
    return manifest_record(
        path.name, kind=kind, rows=len(payload), first_ts=None, last_ts=None, complete=True
    )


def merge_issues(path: Path, rows: list[Row], observed_at: str) -> Row:
    """Merge the issues snapshot on the issue id, stamping each fresh row.

    Issue rows are mutable state, so two rows in this file can describe
    different instants; `_observed_at` is what tells them apart.
    """
    prior: dict[str, Row] = {}
    if path.exists():
        prior = {str(row["id"]): row for row in json.loads(path.read_text())}
    fresh = {str(row["id"]): row | {"_observed_at": observed_at} for row in rows}
    merged = prior | fresh
    ordered = [merged[key] for key in sorted(merged)]
    _write_atomic(path, json.dumps(ordered, indent=1, sort_keys=True))
    log(f"  {path.name}: {len(ordered)} rows ({len(prior.keys() - fresh.keys())} carried over)")
    return manifest_record(
        path.name, kind="issues", rows=len(ordered), first_ts=None, last_ts=None, complete=True
    )


def _write_atomic(path: Path, text: str) -> None:
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text)
    tmp.replace(path)


def resolve_org(client: Sentry, requested: str | None) -> str:
    """Pick the org and point the client at its region host.

    Sentry shards orgs across regions, and the global host only redirects. Taking
    regionUrl from the org itself avoids hardcoding `us.` and breaking for an EU org.
    """
    orgs = client.get("/organizations/")
    if requested:
        match = next((o for o in orgs if o["slug"] == requested), None)
        if match is None:
            sys.exit(f"org {requested!r} not visible to this token; saw {[o['slug'] for o in orgs]}")
    elif len(orgs) == 1:
        match = orgs[0]
    else:
        sys.exit(f"token sees {len(orgs)} orgs; pass --org from {[o['slug'] for o in orgs]}")
    client.base = f"{match['links']['regionUrl']}/api/0"
    return str(match["slug"])


def pull_issues(
    client: Sentry, org: str, api_window: dict[str, str]
) -> Iterator[tuple[Row, list[Row]]]:
    """Each issue with activity in the window, org-wide, with its full events.

    One org-level listing rather than a per-project loop -- every issue type
    comes through it, uptime included, with its project inline. The per-issue
    events endpoint stays, because it is the only source of full payloads for
    non-error issue types. An empty `query` overrides the default
    "is:unresolved", so resolved and ignored issues come through too.
    """
    issues = client.get(
        f"/organizations/{org}/issues/", query="", limit="100", project="-1", **api_window
    )
    log(f"{org}: {len(issues)} issues in the window")
    for issue in issues:
        slug = issue["project"]["slug"]
        issue["_project"] = slug
        log(f"  {issue['shortId']} ({issue['issueType']})")
        events = client.get(f"/issues/{issue['id']}/events/", full="true", limit="100", **api_window)
        for event in events:
            event |= {
                "_project": slug,
                "_issue_id": issue["id"],
                "_short_id": issue["shortId"],
                "_issue_title": issue["title"],
                "_issue_category": issue.get("issueCategory"),
                "_issue_type": issue.get("issueType"),
                "_level": issue.get("level"),
            }
        yield issue, events


def verify(client: Sentry, org: str, api_window: dict[str, str], pulled: int) -> bool:
    """Compare the pulled error events against Sentry's own count() aggregate.

    A silent short pull -- a dropped cursor, a mid-run rate limit -- otherwise
    looks exactly like a quiet week. Worth one extra request to rule out.
    """
    log("verifying against Sentry's aggregate")
    counts = client.get(
        f"/organizations/{org}/events/?dataset=errors&field=count()",
        per_page="1", **api_window,
    )
    expected = int(counts[0]["count()"]) if counts else 0
    if expected == pulled:
        log(f"  OK: {expected} error events")
        return True
    log(f"  MISMATCH: Sentry reports {expected} error events, pulled {pulled}")
    return False


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    add_window_args(parser)
    parser.add_argument("--org", help="org slug (default: the only org the token can see)")
    parser.add_argument("--out", type=Path, default=DEFAULT_OUT, help="output directory")
    args = parser.parse_args()
    win = window(args)
    token = preflight("SENTRY_API_TOKEN")["SENTRY_API_TOKEN"]

    client = Sentry(token)
    org = resolve_org(client, args.org)
    api_window = {"start": win.start.strftime(TIME_FMT), "end": win.end.strftime(TIME_FMT)}
    observed_at = datetime.now(UTC).isoformat()
    log(f"pulling {org}: {api_window['start']} -> {api_window['end']}")

    out: Path = args.out
    (out / "events").mkdir(parents=True, exist_ok=True)
    records: list[Row] = []

    projects = client.get(f"/organizations/{org}/projects/")
    records.append(write_snapshot(out / "projects.json", projects, kind="projects"))

    pulled = list(pull_issues(client, org, api_window))

    # The count() verification below covers the Discover stream; the manifest
    # marks the event files complete only when it passes.
    log("discover: errors dataset")
    fields = "&".join(f"field={urllib.parse.quote(f)}" for f in DISCOVER_FIELDS)
    discover = client.get(
        f"/organizations/{org}/events/?dataset=errors&{fields}",
        per_page="100", sort="-timestamp", **api_window,
    )
    verified = verify(client, org, api_window, len(discover))

    records.append(merge_issues(out / "issues.json", [issue for issue, _ in pulled], observed_at))
    all_events: list[Row] = []
    for issue, issue_events in pulled:
        all_events.extend(issue_events)
        if issue_events:
            records.append(
                write_events(
                    out / "events" / f"{issue['shortId']}.ndjson", issue_events,
                    kind="issue_events", complete=verified,
                )
            )
    records.append(write_events(out / "events.ndjson", all_events, kind="events", complete=verified))
    records.append(
        write_events(out / "discover_errors.ndjson", discover, kind="discover", complete=verified)
    )
    log("releases")
    releases = client.get(f"/organizations/{org}/releases/", per_page="100")
    records.append(write_snapshot(out / "releases.json", releases, kind="releases"))

    update_manifest(out, records)
    if not verified:
        raise SystemExit(1)


if __name__ == "__main__":
    main()
