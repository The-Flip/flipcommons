#!/usr/bin/env python3
"""Download Sentry issues, events and releases into production_logs/dumps/sentry/.

Re-runnable in either direction: no --days, however narrow, discards what a
wider run reached. The files differ in how a re-run combines with the copy on
disk:

  * Event streams (events.ndjson, discover_errors.ndjson, events/*.ndjson) are
    APPEND-shaped and MERGE. Sentry drops events at 90 days, so a dump pulled
    at --days 90 months ago holds events the API can no longer return, and
    rewriting it from a narrower window would destroy the only copy. Deduped on
    the event id; a re-fetched event supersedes the stored one.
  * issues.json is a windowed snapshot of MUTABLE state -- an issue's status, its
    all-time count, its lastSeen -- so it has no timestamp axis to append along.
    It MERGES on the issue id, and every row carries `_observed_at`, the instant
    the pull that wrote it read Sentry. That stamp is what makes merging honest:
    rows here describe different instants, and without it a carried-over row
    would silently claim to be current. Read it before trusting a count.
  * projects.json and releases.json are fetched org-wide rather than windowed, so
    --days cannot narrow them and they are simply REPLACED.

Each merged file reports how many rows it carried over. Nothing here interprets
the data -- shaping and grain rules belong to production_logs/analyze/sql/.

    production_logs/pull/sentry                  # last 30 days
    production_logs/pull/sentry --days 90        # Sentry's retention ceiling
    production_logs/pull/sentry --org some-org --out /tmp/dump

Needs SENTRY_API_TOKEN, taken from the environment or read out of the repo's
.env. Stdlib only, so it runs without a virtualenv.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import UTC, datetime, timedelta
from pathlib import Path
from typing import Any, Iterator, NamedTuple

REPO_ROOT = Path(__file__).resolve().parents[2]
DEFAULT_OUT = Path(__file__).resolve().parent.parent / "dumps" / "sentry"
TIME_FMT = "%Y-%m-%dT%H:%M:%S"

# Discover fields worth having as a flat table. Anything nested stays in the
# full event payloads rather than being flattened into a column here.
DISCOVER_FIELDS = (
    "id", "timestamp", "message", "title", "level", "project.name", "release",
    "environment", "transaction", "culprit", "url", "user.id", "user.email",
    "user.ip", "browser.name", "os.name", "sdk.name", "sdk.version", "issue",
    "server_name",
)


class Page(NamedTuple):
    """One API response: its rows, and the cursor URL for the next page if any."""

    rows: list[dict[str, Any]]
    next_url: str | None


def read_token() -> str:
    """SENTRY_API_TOKEN from the environment, falling back to the repo's .env."""
    if token := os.environ.get("SENTRY_API_TOKEN"):
        return token
    env = REPO_ROOT / ".env"
    if env.is_file():
        for line in env.read_text().splitlines():
            key, _, value = line.partition("=")
            if key.strip() == "SENTRY_API_TOKEN":
                return value.strip().strip("\"'")
    sys.exit("SENTRY_API_TOKEN not set and not found in .env")


class Sentry:
    """A thin paginating client. Retries the failures that are worth retrying."""

    def __init__(self, token: str) -> None:
        self._token = token
        # Overwritten with the org's own region host once an org is resolved;
        # sentry.io redirects region-owned resources rather than serving them.
        self.base = "https://sentry.io/api/0"

    def _get(self, url: str) -> Page:
        for attempt in range(6):
            request = urllib.request.Request(
                url, headers={"Authorization": f"Bearer {self._token}"}
            )
            try:
                with urllib.request.urlopen(request, timeout=90) as response:
                    body = json.loads(response.read())
                    rows = body["data"] if isinstance(body, dict) and "data" in body else body
                    return Page(rows, _next_cursor(response.headers.get("Link", "")))
            except urllib.error.HTTPError as error:
                if error.code not in (429, 502, 503, 504):
                    detail = error.read()[:300].decode(errors="replace")
                    raise SystemExit(f"HTTP {error.code} on {url}\n{detail}") from error
                # 429 carries the wait; the 5xxs get exponential backoff.
                delay = int(error.headers.get("Retry-After") or 2**attempt)
                log(f"  {error.code}; retrying in {delay}s")
                time.sleep(delay)
            except (urllib.error.URLError, TimeoutError) as error:
                log(f"  {error}; retrying")
                time.sleep(2**attempt)
        raise SystemExit(f"gave up after repeated failures on {url}")

    def get(self, path: str, **params: str) -> list[dict[str, Any]]:
        """Every row from every page of one endpoint."""
        # Some paths arrive carrying their own query string (the Discover
        # endpoints need repeated `field=` keys, which urlencode cannot express).
        separator = "&" if "?" in path else "?"
        url = f"{self.base}{path}{separator}{urllib.parse.urlencode(params)}" if params else f"{self.base}{path}"
        rows: list[dict[str, Any]] = []
        while url:
            page = self._get(url)
            if not page.rows:
                break
            rows.extend(page.rows)
            url = page.next_url or ""
            time.sleep(0.25)  # deliberately unhurried; these are bulk pulls
        return rows


def _next_cursor(link_header: str) -> str | None:
    """The next-page URL, but only when Sentry says a next page has results.

    Sentry always emits a `next` link. It sets results="false" on the last page,
    so following the link blindly loops forever on an empty response.
    """
    for part in link_header.split(","):
        match = re.search(r'<([^>]+)>;\s*rel="next".*?results="(\w+)"', part)
        if match and match.group(2) == "true":
            return match.group(1)
    return None


def log(message: str) -> None:
    print(message, file=sys.stderr)


def write_json(path: Path, payload: object) -> None:
    """Replace a snapshot file. See the module docstring for which ones may be."""
    write_atomic(path, json.dumps(payload, indent=1, sort_keys=True))
    report(path, len(payload) if isinstance(payload, list) else 1)


def read_json_array(path: Path) -> list[dict[str, Any]]:
    if not path.exists():
        return []
    return list(json.loads(path.read_text()))


def merge_snapshot(
    path: Path, rows: list[dict[str, Any]], key: str, observed_at: str
) -> None:
    """Merge a windowed snapshot into the dump on disk, keyed on `key`.

    Every row carries `_observed_at`, the instant the pull that produced it read
    Sentry. A snapshot row is mutable state, so two rows in this file can describe
    different instants; the stamp is what tells them apart, and without it the only
    honest option would be to replace the file and lose whatever the window missed.
    A re-fetched row supersedes the stored one, stamp and all.
    """
    prior = {str(row[key]): row for row in read_json_array(path)}
    fresh = {str(row[key]): row | {"_observed_at": observed_at} for row in rows}
    merged = prior | fresh
    ordered = [merged[k] for k in sorted(merged)]
    write_atomic(path, json.dumps(ordered, indent=1, sort_keys=True))
    report(path, len(ordered), carried=len(prior.keys() - fresh.keys()))


def event_key(row: dict[str, Any]) -> str:
    """Identity of an event. Sentry's event id is unique across both streams."""
    return str(row.get("id") or json.dumps(row, sort_keys=True))


def event_time(row: dict[str, Any]) -> str:
    """Sort key. Discover rows carry `timestamp`, full payloads carry `dateCreated`."""
    return str(row.get("timestamp") or row.get("dateCreated") or "")


def read_ndjson(path: Path) -> list[dict[str, Any]]:
    if not path.exists():
        return []
    return [json.loads(line) for line in path.read_text().splitlines() if line.strip()]


def write_ndjson(path: Path, rows: list[dict[str, Any]]) -> None:
    """Merge an event stream into the dump on disk, newest first.

    The dump is an INPUT to its own rewrite: it may hold events past Sentry's
    retention that no later fetch can return.
    """
    prior = {event_key(row): row for row in read_ndjson(path)}
    fresh = {event_key(row): row for row in rows}
    merged = prior | fresh          # a re-fetched event supersedes the stored copy
    ordered = sorted(merged.values(), key=event_time, reverse=True)
    write_atomic(path, "".join(json.dumps(row, sort_keys=True) + "\n" for row in ordered))
    report(path, len(ordered), carried=len(prior.keys() - fresh.keys()))


def write_atomic(path: Path, text: str) -> None:
    """Write beside the target and rename over it.

    A merged file is written from its own previous contents, so an interrupt
    partway through a plain truncating write would destroy the window that
    Sentry can no longer serve rather than merely failing to extend it.
    """
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text)
    tmp.replace(path)


def report(path: Path, rows: int, carried: int = 0) -> None:
    detail = f" ({rows - carried} fetched, {carried} carried over)" if carried else ""
    log(f"  {path.name}: {rows} rows{detail}, {path.stat().st_size:,} bytes")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--days", type=int, default=30, help="window to pull (default 30)")
    parser.add_argument("--org", help="org slug (default: the only org the token can see)")
    parser.add_argument("--out", type=Path, default=DEFAULT_OUT, help="output directory")
    args = parser.parse_args()

    client = Sentry(read_token())
    org = resolve_org(client, args.org)

    end = datetime.now(UTC)
    start = end - timedelta(days=args.days)
    observed_at = end.isoformat()
    window = {"start": start.strftime(TIME_FMT), "end": end.strftime(TIME_FMT)}
    log(f"pulling {args.days}d for {org}: {window['start']} -> {window['end']}")

    out: Path = args.out
    (out / "events").mkdir(parents=True, exist_ok=True)

    projects = client.get(f"/organizations/{org}/projects/")
    write_json(out / "projects.json", projects)

    issues, events = [], []
    for issue, issue_events in pull_issues(client, org, projects, window):
        issues.append(issue)
        events.extend(issue_events)
        if issue_events:
            write_ndjson(out / "events" / f"{issue['shortId']}.ndjson", issue_events)

    merge_snapshot(out / "issues.json", issues, key="id", observed_at=observed_at)
    write_ndjson(out / "events.ndjson", events)

    # The Discover errors dataset: one flat row per error event. Cheaper to query
    # than the full payloads, and it is what verifies the pull is complete --
    # compare its per-issue counts against the aggregate below.
    log("discover: errors dataset")
    fields = "&".join(f"field={urllib.parse.quote(f)}" for f in DISCOVER_FIELDS)
    discover = client.get(
        f"/organizations/{org}/events/?dataset=errors&{fields}",
        per_page="100", sort="-timestamp", **window,
    )
    write_ndjson(out / "discover_errors.ndjson", discover)

    log("releases")
    write_json(out / "releases.json", client.get(f"/organizations/{org}/releases/", per_page="100"))

    verify(client, org, window, discover)


def resolve_org(client: Sentry, requested: str | None) -> str:
    """Pick the org and point the client at its region host.

    Sentry shards orgs across regions, and the global host only redirects. Taking
    regionUrl from the org itself avoids hardcoding `us.` and breaking for an EU org.
    """
    orgs = client.get("/organizations/")
    if requested:
        match = next((o for o in orgs if o["slug"] == requested), None)
        if match is None:
            sys.exit(f"org {requested!r} not visible to this token; saw {[o['slug'] for o in orgs]}")
    elif len(orgs) == 1:
        match = orgs[0]
    else:
        sys.exit(f"token sees {len(orgs)} orgs; pass --org from {[o['slug'] for o in orgs]}")
    client.base = f"{match['links']['regionUrl']}/api/0"
    return str(match["slug"])


def pull_issues(
    client: Sentry, org: str, projects: list[dict[str, Any]], window: dict[str, str]
) -> Iterator[tuple[dict[str, Any], list[dict[str, Any]]]]:
    """Each issue in the window, with its full event payloads.

    Per-issue rather than one bulk call because uptime and other non-error issue
    types are absent from the Discover errors dataset entirely -- this endpoint is
    the only way to reach their events.
    """
    for project in projects:
        slug = project["slug"]
        # An empty `query` overrides the default "is:unresolved", so resolved and
        # ignored issues come through too. statsPeriod is rejected on this
        # endpoint for anything past 14d, hence the explicit start/end.
        issues = client.get(f"/projects/{org}/{slug}/issues/", query="", limit="100", **window)
        log(f"{slug}: {len(issues)} issues")
        for issue in issues:
            issue["_project"] = slug
            log(f"  {issue['shortId']} ({issue['issueType']})")
            events = client.get(f"/issues/{issue['id']}/events/", full="true", limit="100", **window)
            for event in events:
                event |= {
                    "_project": slug,
                    "_issue_id": issue["id"],
                    "_short_id": issue["shortId"],
                    "_issue_title": issue["title"],
                    "_issue_category": issue.get("issueCategory"),
                    "_issue_type": issue.get("issueType"),
                    "_level": issue.get("level"),
                }
            yield issue, events


def verify(client: Sentry, org: str, window: dict[str, str], discover: list[dict[str, Any]]) -> None:
    """Compare the pulled error events against Sentry's own count() aggregate.

    A silent short pull -- a dropped cursor, a mid-run rate limit -- otherwise
    looks exactly like a quiet week. Worth one extra request to rule out.
    """
    log("verifying against Sentry's aggregate")
    counts = client.get(
        f"/organizations/{org}/events/?dataset=errors&field=count()",
        per_page="1", **window,
    )
    expected = int(counts[0]["count()"]) if counts else 0
    if expected == len(discover):
        log(f"  OK: {expected} error events")
    else:
        log(f"  MISMATCH: Sentry reports {expected} error events, pulled {len(discover)}")
        sys.exit(1)


if __name__ == "__main__":
    main()
